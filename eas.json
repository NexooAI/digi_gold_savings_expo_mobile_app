{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "BRAND_NAME": "akilajewellers"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "extends": "development",
      "distribution": "internal",
      "env": {
        "BRAND_NAME": "akilajewellers"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "BRAND_NAME": "akilajewellers"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
