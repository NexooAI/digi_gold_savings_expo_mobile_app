{
  "homePage": {
    "background": {
      "image": "bg_login.jpg",
      "overlay": "rgba(255, 255, 255, 0.1)"
    },
    "userInfoCard": {
      "backgroundColor": "#1a2a39",
      "borderRadius": 20,
      "padding": 20,
      "marginTop": 20,
      "shadow": {
        "color": "#1a2a39",
        "offset": { "width": 0, "height": 4 },
        "opacity": 0.3,
        "radius": 8,
        "elevation": 6
      },
      "text": {
        "welcome": {
          "color": "#ffffff",
          "fontSize": 16,
          "fontWeight": "400"
        },
        "userName": {
          "color": "#ffffff",
          "fontSize": 20,
          "fontWeight": "700"
        },
        "schemesCount": {
          "color": "#ffffff",
          "fontSize": 14,
          "opacity": 0.8
        },
        "totalGold": {
          "color": "#ffffff",
          "fontSize": 12,
          "opacity": 0.7
        },
        "totalGoldValue": {
          "color": "#f6ad55",
          "fontSize": 16,
          "fontWeight": "600"
        }
      },
      "profileImage": {
        "width": 50,
        "height": 50,
        "borderRadius": 25,
        "backgroundColor": "#f6ad55"
      }
    },
    "ratesContainer": {
      "marginTop": 20,
      "paddingHorizontal": 16,
      "backgroundColor": "transparent"
    },
    "schemesSection": {
      "marginTop": 20,
      "sectionHeader": {
        "paddingHorizontal": 20,
        "marginBottom": 15,
        "text": {
          "title": {
            "color": "#ffffff",
            "fontSize": 20,
            "fontWeight": "700"
          },
          "subtitle": {
            "color": "#ffffff",
            "fontSize": 14,
            "opacity": 0.8
          }
        },
        "line": {
          "backgroundColor": "#f6ad55",
          "height": 2,
          "borderRadius": 1
        }
      }
    },
    "bannerCard": {
      "backgroundColor": "#ffffff",
      "borderRadius": 20,
      "marginHorizontal": 5,
      "marginBottom": 8,
      "shadow": {
        "color": "#FFD700",
        "offset": { "width": 0, "height": 4 },
        "opacity": 0.12,
        "radius": 12,
        "elevation": 6
      },
      "width": "85%",
      "paddingBottom": 16,
      "image": {
        "width": "100%",
        "height": 200,
        "borderRadius": 20
      },
      "buttons": {
        "row": {
          "flexDirection": "row",
          "justifyContent": "space-between",
          "alignItems": "center",
          "width": "90%",
          "marginTop": 16,
          "gap": 12
        },
        "aboutSchemes": {
          "flex": 1,
          "backgroundColor": "#fffbe6",
          "borderRadius": 10,
          "paddingVertical": 12,
          "borderWidth": 1,
          "borderColor": "#FFD700",
          "shadow": {
            "color": "#FFD700",
            "offset": { "width": 0, "height": 1 },
            "opacity": 0.08,
            "radius": 3,
            "elevation": 1
          },
          "marginRight": 6,
          "text": {
            "color": "#FFD700",
            "fontWeight": "600",
            "fontSize": 15,
            "letterSpacing": 0.2
          }
        },
        "joinNow": {
          "flex": 1,
          "backgroundColor": "#FFD700",
          "borderRadius": 12,
          "paddingVertical": 12,
          "shadow": {
            "color": "#FFD700",
            "offset": { "width": 0, "height": 2 },
            "opacity": 0.15,
            "radius": 6,
            "elevation": 3
          },
          "marginLeft": 6,
          "text": {
            "color": "#ffffff",
            "fontWeight": "700",
            "fontSize": 16,
            "letterSpacing": 0.5,
            "textTransform": "uppercase"
          }
        }
      }
    },
    "components": {
      "flashBanner": {
        "backgroundColor": "rgba(26, 42, 57, 0.9)",
        "borderRadius": 12,
        "marginHorizontal": 16,
        "marginVertical": 10
      },
      "imageSlider": {
        "height": 200,
        "borderRadius": 12,
        "marginHorizontal": 16,
        "marginVertical": 10
      },
      "productsList": {
        "backgroundColor": "rgba(255, 255, 255, 0.1)",
        "borderRadius": 16,
        "marginHorizontal": 16,
        "marginVertical": 10,
        "padding": 16
      },
      "socialMediaCard": {
        "backgroundColor": "rgba(26, 42, 57, 0.8)",
        "borderRadius": 16,
        "marginHorizontal": 16,
        "marginVertical": 10
      },
      "supportContactCard": {
        "backgroundColor": "rgba(26, 42, 57, 0.8)",
        "borderRadius": 16,
        "marginHorizontal": 16,
        "marginVertical": 10
      }
    },
    "animations": {
      "entrance": {
        "duration": 800,
        "easing": "cubic",
        "initialOpacity": 0,
        "finalOpacity": 1,
        "initialScale": 0.8,
        "finalScale": 1
      }
    }
  }
} 